; Dead Waves - Godot 4.4+ project
config_version=5

[application]

config/name="Dead Waves"
config/description="Wave-based co-op zombie shooter with Steam lobbies and leaderboards."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"
Boards="*res://scripts/leaderboards.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
