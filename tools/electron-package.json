{
  "name": "dead-waves",
  "productName": "Dead Waves",
  "version": "2.3.0",
  "description": "Dead Waves: co-op zombie wave shooter",
  "main": "electron-main.js",
  "author": "Dead Waves",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deadwaves.game",
    "productName": "Dead Waves",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "steam-preload.js",
      "game/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "DeadWaves-${version}-portable.exe"
    },
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ]
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
